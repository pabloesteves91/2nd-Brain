rules_version = '2';

// Jede Person sieht und schreibt nur ihre eigenen Notizen und Bilder:
//   users/{uid}/notes/{noteId}
//   (Bilder liegen in Firebase Storage, siehe storage.rules)
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Geschenktes Plus (Familie, Freunde): nur in der Firebase-Konsole anlegen.
    // Dokument-ID = E-Mail (klein geschrieben) oder Benutzer-ID. Jede Person liest nur ihr eigenes Geschenk.
    match /plusGifts/{id} {
      allow get: if request.auth != null
        && (id == request.auth.uid
            || (request.auth.token.email != null && id == request.auth.token.email.lower()));
      allow list, write: if false;
    }

    // Feedback aus der App: alle dürfen senden (auch ohne Konto), niemand kann lesen –
    // nur du in der Firebase-Konsole (Firestore → Daten → feedback).
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['text', 'created_at', 'app', 'platform', 'uid'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.created_at == request.time
        && (request.resource.data.uid == null
            || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read, update, delete: if false;
    }
  }
}
