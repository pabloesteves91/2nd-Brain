rules_version = '2';

// Jede Person sieht und schreibt nur ihre eigenen Notizen und Bilder:
//   users/{uid}/notes/{noteId}
//   (Bilder liegen in Firebase Storage, siehe storage.rules)
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Gemeinsame Notizen: shared/{sid} = { owner, members[], names{uid: E-Mail}, invite, text, updated_at, updated_by }
    // Lesen/Schreiben nur Mitglieder; Beitreten nur mit dem Einladungscode; Löschen nur der Besitzer.
    match /shared/{sid} {
      function signedIn() { return request.auth != null; }
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      // E-Mail-Liste: nur der eigene Eintrag, und nur die echte Adresse aus der Anmeldung
      function namesChanged() { return request.resource.data.get('names', {}).diff(resource.data.get('names', {})).affectedKeys(); }
      function ownEmailOk() { return request.resource.data.get('names', {}).get(request.auth.uid, '') == request.auth.token.get('email', ''); }

      allow read: if isMember();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['owner', 'members', 'names', 'invite', 'text', 'updated_at', 'updated_by'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.get('names', {}).keys().hasOnly([request.auth.uid]) && ownEmailOk()
        && request.resource.data.invite is string && request.resource.data.invite.size() >= 12
        && request.resource.data.text is string && request.resource.data.text.size() <= 20000;
      // Mitglied ändert den Text
      allow update: if isMember()
        && changed().hasOnly(['text', 'updated_at', 'updated_by'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 20000
        && request.resource.data.updated_by == request.auth.uid;
      // Beitreten mit Einladungscode (höchstens 20 Personen)
      allow update: if signedIn() && !(request.auth.uid in resource.data.members)
        && changed().hasOnly(['members', 'joinToken', 'names'])
        && namesChanged().hasOnly([request.auth.uid]) && ownEmailOk()
        && request.resource.data.joinToken == resource.data.invite
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members
        && resource.data.members.size() < 20;
      // Verlassen (nicht der Besitzer – der beendet das Teilen durch Löschen)
      allow update: if isMember() && request.auth.uid != resource.data.owner
        && changed().hasOnly(['members', 'names'])
        && namesChanged().hasOnly([request.auth.uid])
        && resource.data.members.hasAll(request.resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && !(request.auth.uid in request.resource.data.members);
      // Besitzer entfernt eine andere Person (sich selbst nie)
      allow update: if signedIn() && request.auth.uid == resource.data.owner
        && changed().hasOnly(['members', 'names'])
        && resource.data.members.hasAll(request.resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && request.auth.uid in request.resource.data.members
        && !(request.auth.uid in namesChanged());
      allow delete: if signedIn() && request.auth.uid == resource.data.owner;
    }

    // Geschenktes Plus (Familie, Freunde): nur in der Firebase-Konsole anlegen.
    // Dokument-ID = E-Mail (klein geschrieben) oder Benutzer-ID. Jede Person liest nur ihr eigenes Geschenk.
    match /plusGifts/{id} {
      allow get: if request.auth != null
        && (id == request.auth.uid
            || (request.auth.token.email != null && id == request.auth.token.email.lower()));
      allow list, write: if false;
    }

    // Feedback aus der App: alle dürfen senden (auch ohne Konto), niemand kann lesen –
    // nur du in der Firebase-Konsole (Firestore → Daten → feedback).
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['text', 'created_at', 'app', 'platform', 'uid'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.created_at == request.time
        && (request.resource.data.uid == null
            || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read, update, delete: if false;
    }
  }
}
