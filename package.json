{
  "name": "2nd-brain",
  "version": "1.0.0",
  "private": true,
  "description": "Öffnen. Schreiben. Schliessen.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "sync": "npm run build && npx cap sync ios && node scripts/ios-files.mjs",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "serve": "python3 -m http.server 8000",
    "sync:android": "npm run build && npx cap sync android",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "ios:files": "node scripts/ios-files.mjs"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "7.1.0",
    "@capacitor/android": "7.6.10",
    "@capacitor/app": "7.1.2",
    "@capacitor/camera": "7.0.5",
    "@capacitor/core": "7.6.10",
    "@capacitor/haptics": "7.0.5",
    "@capacitor/ios": "7.6.10",
    "@capacitor/keyboard": "7.0.6",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor/share": "7.0.4",
    "@capacitor/status-bar": "7.0.6",
    "@capgo/capacitor-native-biometric": "7.6.0",
    "@capgo/native-purchases": "7.16.2"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.5"
  }
}
